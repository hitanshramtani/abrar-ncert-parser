    "question_type": "conceptual",
    "question_text": "Describe the forms of relationship between pressure groups and political parties?",
    "question_latex": null,
    "mcq_options": [],
    "correct_option": null,
    "question_image": {
      "present": false,
      "description": null,
      "cloudinary_url": null,
