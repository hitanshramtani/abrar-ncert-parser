    "answer_text": "Therefore, two consecutive positive integers will be 13 and 14.",
    "answer_latex": null,
    "steps": [
      {
        "step_number": 1,
        "description": "Set up the equation for the sum of squares of consecutive integers.",
        "expression": "x^{2} + (x + 1)^{2} = 365"
      },
      {
        "step_number": 2,
        "description": "Simplify the equation.",
        "expression": "2x^{2} + 2x + 1 = 365"
      },
      {
        "step_number": 3,
        "description": "Rearrange to form a standard quadratic equation.",
        "expression": "2x^{2} + 2x - 364 = 0"
      },
      {
        "step_number": 4,
        "description": "Factor the quadratic equation.",
