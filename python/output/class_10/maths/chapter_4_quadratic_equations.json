    "question_text": "Find two consecutive positive integers, sum of whose squares is 365.",
    "question_latex": "\\begin{array}{r}{\\operatorname{Given}\\operatorname{lat}x^{2}+\\left(x+1\\right)^{2}=365}\\\\ {\\Rightarrow x^{2}+x^{2}+1+2x=365}\\\\ {\\Rightarrow x^{2}+2x-182=0}\\\\ {\\Rightarrow x^{2}+4x-13x-182=0}\\\\ {\\Rightarrow(x+14)(x-13)=0}\\end{array}",
    "mcq_options": [],
    "correct_option": null,
    "question_image": {
      "present": false,
      "description": null,
