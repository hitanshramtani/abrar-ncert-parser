      "latex_extracted": "\\left\\begin{array}{r l}{\\left\\lfloor}&{{}{\\mathrm{reriary~consumers}}}\\\\ {\\quad{\\mathrm{~Sertary~consumers}}}\\\\ {\\quad{\\mathrm{~Prodary~consumers}}}\\\\ {\\quad{\\mathrm{~TroohicLewers}}}\\end{array}\\right\\rfloor}\\end{array}",
