        "description": "Rectify all the errors committed in the Cash Book.",
        "expression": null
      },
      {
        "step_number": 3,
        "description": "Enter transactions in the debit of the Cash Book that are only in the credit of the Pass Book.",
        "expression": null
      },
      {
        "step_number": 4,
        "description": "Enter transactions in the credit of the Cash Book that are only in the debit of the Pass Book.",
        "expression": null
      },
      {
        "step_number": 5,
        "description": "Total the Cash Book and calculate the balancing figure.",
        "expression": null
      }
