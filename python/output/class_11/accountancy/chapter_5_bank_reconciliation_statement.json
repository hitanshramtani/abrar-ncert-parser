    "question_type": "conceptual",
    "question_text": "What is a bank overdraft?",
    "question_latex": null,
    "mcq_options": [],
    "correct_option": null,
    "question_image": {
      "present": false,
      "description": null,
      "cloudinary_url": null,
      "latex_extracted": null,
      "source_page_number": null,
      "source_image_index": null,
      "ownership": "unknown"
    },
    "parts": [],
    "answer_text": "Bank overdraft is a liability to an account holder. When the account holder withdraws excess amount over his/her available bank balance, he/she runs a negative bank balance. The negative bank balance is an obligation to the account holder and is called bank overdraft. In other words, bank overdraft is the excess of withdrawal over deposits.",
    "answer_latex": null,
    "steps": [],
    "final_answer": "Therefore, a bank overdraft represents a negative balance that the account holder must repay.",
    "answer_image": {
      "present": false,
      "description": null,
      "cloudinary_url": null,
      "latex_extracted": null,
      "source_page_number": null,
      "source_image_index": null,
