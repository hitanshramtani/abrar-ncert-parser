        "option_label": "(A)",
        "option_text": "Parathyroid hormone (PTH)"
      },
      {
        "option_label": "(B)",
        "option_text": "Thyroid hormones"
      },
      {
        "option_label": "(C)",
        "option_text": "Thymosins"
      },
      {
        "option_label": "(D)",
        "option_text": "Androgens\n(e) Estrogens\n(f) Insulin and Glucagon"
      }
    ],
    "correct_option": null,
    "question_image": {
