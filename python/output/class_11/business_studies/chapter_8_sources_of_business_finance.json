    "chapter_name": "sources of business finance",
    "question_type": "conceptual",
    "question_text": "List sources of raising long-term and short-term finance.",
    "question_latex": null,
    "mcq_options": [],
    "correct_option": null,
    "question_image": {
      "present": false,
      "description": null,
