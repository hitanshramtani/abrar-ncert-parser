    "subject": "business_studies",
    "chapter_number": 8,
    "chapter_name": "sources of business finance",
    "question_type": "conceptual",
    "question_text": "What preferential rights are enjoyed by preference shareholders? Explain.",
    "question_latex": null,
    "mcq_options": [],
    "correct_option": null,
    "question_image": {
      "present": false,
      "description": null,
      "cloudinary_url": null,
      "latex_extracted": null,
      "source_page_number": null,
      "source_image_index": null,
      "ownership": "unknown"
    },
    "parts": [],
    "answer_text": "The preference shareholders enjoy a preferential position over equity shareholders by:\n→ They receive a fixed rate of dividend, out of the net profits of the company, before any dividend is declared for equity shareholders;\n→ They receive their capital after the claims of the company’s creditors have been settled, at the time of liquidation.",
    "answer_latex": null,
    "steps": [],
    "final_answer": "Therefore, preference shareholders have a preferential position in terms of dividends and capital repayment.",
    "answer_image": {
      "present": false,
      "description": null,
