    "class": 11,
    "subject": "business_studies",
    "chapter_number": 8,
    "chapter_name": "sources of business finance",
    "question_type": "conceptual",
    "question_text": "What is the difference between the internal and external sources of raising funds? Explain.",
    "question_latex": null,
    "mcq_options": [],
    "correct_option": null,
    "question_image": {
      "present": false,
      "description": null,
      "cloudinary_url": null,
      "latex_extracted": null,
      "source_page_number": null,
      "source_image_index": null,
      "ownership": "unknown"
    },
    "parts": [],
    "answer_text": "Internal sources of funds are those that are generated within a business, such as retained earnings and accelerated collection of receivables. External sources include funds from outside the business, such as loans from banks and issuing debentures.",
    "answer_latex": null,
    "steps": [],
    "final_answer": "In summary, internal sources are generated within the business, while external sources come from outside.",
    "answer_image": {
      "present": false,
