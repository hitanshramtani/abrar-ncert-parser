    "question_type": "mcq",
    "question_text": "In changing the state of a gas adiabatically from an equilibrium state A to another equilibrium state B, an amount of work equal to 22.3 J is done on the system. If the gas is taken from state A to B via a process in which the net heat absorbed by the system is 9.35 cal, how much is the net work done by the system in the latter case? (Take 1 cal = 4.19 J)",
    "question_latex": null,
    "mcq_options": [],
    "correct_option": null,
    "question_image": {
      "present": false,
      "description": null,
      "cloudinary_url": null,
      "latex_extracted": null,
      "source_page_number": null,
      "source_image_index": null,
      "ownership": "unknown"
    },
    "parts": [],
    "answer_text": "Therefore, 16.88 J of work is done by the system.",
    "answer_latex": null,
    "steps": [
      {
        "step_number": 1,
        "description": "Calculate the heat absorbed in Joules.",
        "expression": "ΔQ = 9.35 \\text{ cal} \\times 4.19 \\text{ J/cal} = 39.1765 \\text{ J}"
      },
      {
        "step_number": 2,
        "description": "Use the first law of thermodynamics to find the net work done.",
        "expression": "ΔW = ΔQ - ΔU = 39.1765 - 22.3"
      },
      {
        "step_number": 3,
        "description": "Calculate the final work done by the system.",
        "expression": "ΔW = 16.8765 \\text{ J}"
      }
    ],
    "final_answer": "Therefore, 16.88 J of work is done by the system.",
