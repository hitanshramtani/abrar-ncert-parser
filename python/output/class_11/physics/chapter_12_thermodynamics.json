        "step_number": 4,
        "description": "Calculate the rate of consumption of the fuel.",
        "expression": "Rate = \frac{ΔQ}{\text{Heat of combustion}} = \frac{6.3 \times 10^5}{4.0 \times 10^4} = 15.75 \text{ g/min}"
      }
