      "source_page_number": null,
      "source_image_index": null,
      "ownership": "unknown"
    },
    "parts": [],
    "answer_text": "Heat flows from the body at the higher temperature to the body at the lower temperature until equilibrium is achieved, which is only equal to the mean temperature when the thermal capacities of both bodies are equal.",
    "answer_latex": null,
