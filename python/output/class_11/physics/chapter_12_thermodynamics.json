        "description": "Calculate the rise in temperature.",
        "expression": "ΔT = 77 - 27 = 50 °C"
      },
      {
        "step_number": 2,
        "description": "Calculate the mass of water flowing per minute.",
        "expression": "m = 3.0 \text{ litres/min} = 3000 \text{ g/min}"
      },
      {
        "step_number": 3,
        "description": "Calculate the total heat used.",
        "expression": "ΔQ = mcΔT = 3000 \times 4.22 \times 50 = 6.3 \times 10^5 \text{ J/min}"
      },
