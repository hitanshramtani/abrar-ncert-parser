    "question_id": "Q8.10",
    "class": 11,
    "subject": "statistics",
    "chapter_number": 8,
    "chapter_name": "index numbers",
    "question_type": "conceptual",
    "question_text": "What does a consumer price index for industrial workers measure?",
    "question_latex": null,
    "mcq_options": [],
    "correct_option": null,
    "question_image": {
      "present": false,
      "description": null,
      "cloudinary_url": null,
      "latex_extracted": null,
      "source_page_number": null,
      "source_image_index": null,
      "ownership": "unknown"
    },
    "parts": [],
    "answer_text": "A Consumer Price Index for Industrial Workers measures the impact of changes in the retail prices on the cost of living of industrial workers. In a country like India, CPI for industrial workers is estimated and published by the Labour Bureau, Shimla taking 1982 as the base year for the current series. In India, CPI for industrial workers is the most popular index and is used by the government to regulate Dearness Allowance (D.A.) to compensate its employees against the price rise. The weight schemes in CPI for Industrial Workers include food, pan, supari, tobacco, fuel and lighting, housing, clothing, and miscellaneous expenses. Food being the most important component has the highest weight. Thus, it implies that the food price changes have a significant impact on the CPI.",
    "answer_latex": null,
    "steps": [],
    "final_answer": "Thus, the CPI reflects the cost of living changes for industrial workers based on retail price changes.",
    "answer_image": {
      "present": false,
      "description": null,
      "cloudinary_url": null,
      "latex_extracted": null,
      "source_page_number": null,
      "source_image_index": null,
      "ownership": "unknown"
    },
    "difficulty_rating": 2,
    "difficulty_reasoning": "Requires understanding of CPI and its implications for cost of living.",
    "topics_tags": [
      "Consumer Price Index",
      "Cost of Living",
      "Industrial Workers"
    ],
    "confidence_score": 0.95,
    "confidence_issues": [],
    "question_images": [],
    "answer_images": []
