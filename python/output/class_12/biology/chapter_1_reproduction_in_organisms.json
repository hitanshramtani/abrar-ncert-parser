    "subject": "biology",
    "chapter_number": 1,
    "chapter_name": "reproduction in organisms",
    "question_type": "conceptual",
    "question_text": "Higher organisms have resorted to sexual reproduction in spite of its complexity. Why?",
    "question_latex": null,
    "mcq_options": [],
    "correct_option": null,
    "question_image": {
      "present": false,
      "description": null,
