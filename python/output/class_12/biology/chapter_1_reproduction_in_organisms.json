    "class": 12,
    "subject": "biology",
    "chapter_number": 1,
    "chapter_name": "reproduction in organisms",
    "question_type": "conceptual",
    "question_text": "Describe the post-fertilization changes in a flower.",
    "question_latex": null,
    "mcq_options": [],
