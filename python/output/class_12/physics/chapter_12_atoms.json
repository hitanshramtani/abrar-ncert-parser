        "description": "Identify the total energy of the hydrogen atom.",
        "expression": "E = -13.6 \text{ eV}"
      },
      {
        "step_number": 2,
        "description": "Calculate kinetic energy as the negative of total energy.",
        "expression": "K.E. = -E = -(-13.6) = 13.6 \text{ eV}"
      },
      {
        "step_number": 3,
        "description": "Calculate potential energy as negative two times the kinetic energy.",
