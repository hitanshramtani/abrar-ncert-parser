    "question_type": "conceptual",
    "question_text": "भाषा और अक्षर के संबंधों के बारे में एक अनुच्छेद लिखो।",
    "question_latex": null,
    "mcq_options": [],
    "correct_option": null,
    "question_image": {
      "present": false,
      "description": null,
