    "question_type": "numerical",
    "question_text": "A 15 m long ladder reached a window 12 m high from the ground on placing it against a wall at a distance a. Find the distance of the foot of the ladder from the wall.",
    "question_latex": null,
    "mcq_options": [],
    "correct_option": null,
    "question_image": {
      "present": true,
      "description": "Diagram showing a ladder leaning against a wall.",
      "cloudinary_url": "https://res.cloudinary.com/dyaopfkaz/image/upload/v1777835738/ncert/maths/6/img_12_0.jpg",
      "latex_extracted": null,
      "source_page_number": null,
      "source_image_index": null,
      "ownership": "question"
    },
    "parts": [],
    "answer_text": "By applying Pythagoras theorem, we find that the distance of the foot of the ladder from the wall is 9 m.",
    "answer_latex": "a = 9",
    "steps": [
      {
        "step_number": 1,
        "description": "Apply Pythagoras theorem: (15)^2 = (12)^2 + a^2",
        "expression": "225 = 144 + a^2"
      },
      {
        "step_number": 2,
        "description": "Rearrange to find a^2.",
        "expression": "a^2 = 225 - 144 = 81"
      },
      {
        "step_number": 3,
        "description": "Take the square root to find a.",
        "expression": "a = 9"
      }
    ],
    "final_answer": "Therefore, the distance of the foot of the ladder from the wall is 9 m.",
