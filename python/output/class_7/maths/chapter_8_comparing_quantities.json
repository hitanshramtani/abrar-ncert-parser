    "question_type": "numerical",
    "question_text": "Out of 15,000 voters in a constituency, 60% voted. Find the percentage of voters who did not vote. Can you now find how many actually did not vote?",
    "question_latex": null,
    "mcq_options": [],
    "correct_option": null,
    "question_image": {
      "present": false,
      "description": null,
      "cloudinary_url": null,
      "latex_extracted": null,
      "source_page_number": null,
      "source_image_index": null,
      "ownership": "unknown"
    },
    "parts": [],
    "answer_text": "Percentage of those who did not vote = 100% - 60% = 40%. Number of people who did not vote = 40% of 15000. Therefore, 6000 people did not vote.",
    "answer_latex": null,
    "steps": [
      {
        "step_number": 1,
        "description": "Calculate the percentage of voters who did not vote.",
        "expression": "100% - 60%"
      },
      {
        "step_number": 2,
        "description": "Calculate the number of voters who did not vote.",
        "expression": "0.40 \\times 15000"
      }
    ],
    "final_answer": "Therefore, 6000 people did not vote.",
    "answer_image": {
      "present": false,
      "description": null,
