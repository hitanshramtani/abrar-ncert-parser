    "class": 7,
    "subject": "science",
    "chapter_number": 15,
    "chapter_name": "light",
    "question_type": "conceptual",
    "question_text": "What is a virtual image? Give one situation where a virtual image is formed.",
    "question_latex": null,
    "mcq_options": [],
    "correct_option": null,
    "question_image": {
      "present": false,
      "description": null,
