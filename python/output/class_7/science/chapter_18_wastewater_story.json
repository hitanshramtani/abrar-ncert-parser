    "question_id": "Q18.2",
    "class": 7,
    "subject": "science",
    "chapter_number": 18,
    "chapter_name": "wastewater story",
    "question_type": "conceptual",
    "question_text": "What is sewage? Explain why it is harmful to discharge untreated sewage into rivers or seas.",
    "question_latex": null,
    "mcq_options": [],
    "correct_option": null,
    "question_image": {
      "present": false,
      "description": null,
      "cloudinary_url": null,
      "latex_extracted": null,
      "source_page_number": null,
      "source_image_index": null,
      "ownership": "unknown"
    },
    "parts": [],
    "answer_text": "Sewage is the wastewater containing both liquid and solid wastes produced by human activities from homes, industries, hospitals, offices, etc. Sewage contains various contaminants including disease-causing bacteria and other microbes. If untreated sewage is discharged into rivers or seas, then the water in the rivers or seas would also get contaminated. If this contaminated water is used for drinking, then it can cause diseases such as cholera, typhoid, dysentery, etc. which may lead to death. That is why it is harmful to discharge untreated sewage into rivers or seas.",
    "answer_latex": null,
    "steps": [],
    "final_answer": "Therefore, untreated sewage can lead to serious health issues.",
    "answer_image": {
      "present": false,
      "description": null,
      "cloudinary_url": null,
      "latex_extracted": null,
      "source_page_number": null,
      "source_image_index": null,
      "ownership": "unknown"
    },
    "difficulty_rating": 3,
    "difficulty_reasoning": "Requires understanding of sewage and its impact on health.",
    "topics_tags": [
      "Sewage",
      "Water Contamination",
      "Health Hazards"
    ],
    "confidence_score": 0.98,
    "confidence_issues": [],
    "question_images": [],
    "answer_images": []
  },
