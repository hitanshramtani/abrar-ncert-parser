    "question_type": "conceptual",
    "question_text": "Name the type of carbohydrate that can be digested by ruminants but not by humans. Give the reason also.",
    "question_latex": null,
    "mcq_options": [],
    "correct_option": null,
    "question_image": {
      "present": false,
      "description": null,
      "cloudinary_url": null,
      "latex_extracted": null,
      "source_page_number": null,
      "source_image_index": null,
      "ownership": "unknown"
    },
    "parts": [],
    "answer_text": "Cellulose is a type of carbohydrate that can be digested by ruminants and not by humans. Ruminants have a large sac-like structure between small and large intestine where the food containing cellulose is digested by the action of certain bacteria. On the other hand, humans cannot digest cellulose, as the cellulose digesting enzymes are absent in them.",
    "answer_latex": null,
    "steps": [],
    "final_answer": "Thus, cellulose digestion is a unique feature of ruminants.",
    "answer_image": {
      "present": false,
      "description": null,
