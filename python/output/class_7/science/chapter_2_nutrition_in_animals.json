    "chapter_name": "nutrition in animals",
    "question_type": "conceptual",
    "question_text": "What are villi? What is their location and function?",
    "question_latex": null,
    "mcq_options": [],
    "correct_option": null,
    "question_image": {
      "present": false,
      "description": null,
