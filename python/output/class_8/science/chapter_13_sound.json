    "question_type": "conceptual",
    "question_text": "Lightning and thunder take place in the sky at the same time and at the same distance from us. Lightning is seen earlier and thunder is heard later. Can you explain?",
    "question_latex": null,
    "mcq_options": [],
    "correct_option": null,
    "question_image": {
      "present": false,
      "description": null,
      "cloudinary_url": null,
      "latex_extracted": null,
      "source_page_number": null,
      "source_image_index": null,
      "ownership": "unknown"
    },
    "parts": [],
    "answer_text": "The speed of sound is less than the speed of light. Hence, light reaches us before the sound during a lightning, which is accompanied by thundering.",
    "answer_latex": null,
    "steps": [],
    "final_answer": "Therefore, we see lightning before we hear thunder.",
    "answer_image": {
      "present": false,
