    "mcq_options": [],
    "correct_option": null,
    "question_image": {
      "present": false,
      "description": null,
      "cloudinary_url": null,
      "latex_extracted": null,
      "source_page_number": null,
      "source_image_index": null,
      "ownership": "unknown"
    },
    "parts": [],
    "answer_text": "The time required to complete one oscillation is known as time period.",
    "answer_latex": null,
    "steps": [
      {
        "step_number": 1,
        "description": "Identify the frequency of the mosquito's wing vibrations.",
        "expression": "f = 500 \text{ Hz}"
      },
      {
        "step_number": 2,
        "description": "Calculate the time period using the inverse of frequency.",
        "expression": "T = \frac{1}{f} = \frac{1}{500} = 0.002 \text{ s}"
      }
    ],
    "final_answer": "The time period of the vibration is 0.002 seconds.",
    "answer_image": {
      "present": false,
