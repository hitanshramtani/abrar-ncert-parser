    "question_text": "A park, in the shape of a quadrilateral ABCD, has C = 90°, AB = 9 m, BC = 12 m, CD = 5 m and AD = 8 m. How much area does it occupy?",
    "question_latex": null,
    "mcq_options": [],
    "correct_option": null,
    "question_image": {
      "present": false,
      "description": null,
      "cloudinary_url": null,
