        "description": "Identify that x = z due to alternate interior angles.",
        "expression": null
      },
      {
        "step_number": 3,
        "description": "Set up the ratio for y and z.",
        "expression": "y: z = 3: 7"
      },
      {
        "step_number": 4,
        "description": "Let y = 3a and z = 7a.",
        "expression": null
      },
      {
        "step_number": 5,
        "description": "Use co-interior angles to set up the equation.",
        "expression": "x + y = 180º"
      },
      {
        "step_number": 6,
        "description": "Substitute z in the equation.",
        "expression": "7a + 3a = 180º"
      },
      {
        "step_number": 7,
        "description": "Solve for a.",
        "expression": "10a = 180º, a = 18º"
      },
      {
        "step_number": 8,
        "description": "Calculate x.",
        "expression": "x = 7a = 7 × 18º = 126º"
      }
    ],
    "final_answer": "Therefore, the value of x is 126º.",
