      "latex_extracted": "\\begin{array}{l}{{\\begin{array}{l}{{\\mathbf{\\hat{e}}}}\\\\ {{\\bullet_{\\mathbf{\\hat{e}}}\\qquad\\sum_{\\mathbf{\\hat{e}}}\\qquad\\sum_{\\mathbf{\\hat{e}}=\\mathbf{\\hat{e}}}\\qquad\\sum_{\\mathbf{\\hat{e}}=\\mathbf{\\hat{e}}}\\qquad\\mathbf{\\hat{e}}\\neq\\sum_{\\mathbf{\\hat{e}}}}}\\\\ {{\\vdots}}\\\\ {{\\vdots}}\\\\ {{\\vdots}}\\\\ {{\\vdots}}\\\\ {{\\vdots}}\\\\ {{\\vdots}}\\\\ {{\\vdots}}\\\\ {{\\vdots}}\\end{array}}\\end{array}",
